{
  "name": "dm-debug-station",
  "private": true,
  "version": "1.0.0",
  "description": "Three-bus motor workbench for DMDebug serial protocol v2",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --import ./tests/register-typescript.mjs --test tests/transport.test.ts",
    "dev": "vite",
    "build": "tsc && vite build && node scripts/export-portable.mjs",
    "build:web": "npm run build",
    "build:desktop": "tauri build --no-bundle && node scripts/copy-desktop.mjs",
    "build:all": "npm run build:desktop",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "jotai": "^2.11.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
